# Required: copy your working values here. Never post this file or screenshots of secrets.
DISCORD_TOKEN=
PING_USER_ID=0
RAM_CHANNEL_NAME=ddr5
GPU_CHANNEL_NAME=gpu
OPS_CHANNEL_NAME=dealbot-ops

# Product limits
RAM_MAX_PRICE=200
RAM_HOT_PRICE=150
RAM_INSANE_PRICE=120
RAM_MIN_SPEED_MT_S=5000
RAM_SPEEDS=5000,5200,5600,6000,6400
RAM_CAPACITIES_GB=16,32
RAM_QUERY_TEMPLATE={capacity}GB DDR5 desktop memory {speed}MHz
GPU_MAX_PRICE=600
GPU_GREAT_PRICE=550
GPU_HOT_PRICE=500

# Optional second GPU model, tracked alongside the RX 9070 XT with its own
# price ceiling (different cards are worth different amounts).
GPU2_ENABLED=false
GPU2_LABEL=RX 7900 XTX
GPU2_QUERY=RX 7900 XTX graphics card
GPU2_MAX_PRICE=700

TAX_RATE_PERCENT=6.625

# Official fast APIs
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MIN_FEEDBACK_SCORE=100
EBAY_MIN_FEEDBACK_PERCENT=97.0
EBAY_MAX_RESULTS=50
EBAY_INTERVAL_SECONDS=60
BESTBUY_API_KEY=
BESTBUY_INTERVAL_SECONDS=60

# Approved Reddit Data API (optional). Leave all three blank to skip Reddit
# entirely - filling in only some of them is a configuration error at startup.
# If you do use it, REDDIT_USER_AGENT should look like:
#   windows:ddr5-9070xt-dealbot:v6.1 (by /u/YOUR_USERNAME)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_SUBREDDITS=buildapcsales,buildapcsalesuk,pcpartsales
REDDIT_INTERVAL_SECONDS=90

# Paste up to two Slickdeals RSS/search-alert feed URLs (optional; no page
# scraping). Each is just a search feed - e.g. one for "ddr5", one for
# "rx 9070 xt" - both slots are polled and merged, no need to split by kind.
SLICKDEALS_FEED_URL=
SLICKDEALS_FEED_URL_2=
SLICKDEALS_INTERVAL_SECONDS=90

# Zoho IMAP monitoring (optional). Use a Zoho app password, not your main password.
ZOHO_IMAP_ENABLED=false
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
ZOHO_FOLDER=INBOX
EMAIL_INTERVAL_SECONDS=120

# Micro Center store-specific results (optional)
MICROCENTER_STORE_ID=
MICROCENTER_ZIP=

# Scheduler and safe anti-block settings
WATCHLIST_INTERVAL_SECONDS=120
API_WATCH_BATCH_SIZE=2
# Each scraped store now has its own search interval (set in dealbot/config.py's
# STORES list, not here) based on whether that store has actually blocked the
# bot before. Ask to have a specific store's speed changed rather than editing
# code directly.
STORE_CONCURRENCY=2
BLOCKED_BACKOFF_MIN_SECONDS=1800
BLOCKED_BACKOFF_MAX_SECONDS=3600
MAX_DETAILS_PER_STORE=10
BROWSER_FALLBACK_ENABLED=true

# Accuracy / resale
MIN_IDENTITY_CONFIDENCE=88
UNUSUAL_PRICE_RATIO=0.70
CORROBORATION_TOLERANCE_PERCENT=8
RESALE_FEE_PERCENT=13.6
RESALE_FIXED_FEE=0.40
RESALE_OUTBOUND_SHIPPING=10
RESALE_RETURN_RESERVE_PERCENT=3
RESALE_MIN_PROFIT=40
SOLD_COMPS_FILE=sold_comps.csv

# Local status webpage (open http://localhost:8765 in a browser instead of
# typing /status in Discord every time)
STATUS_WEB_ENABLED=true
STATUS_WEB_PORT=8765

# Price history chart attached to each Discord alert
PRICE_CHART_ENABLED=true
PRICE_CHART_HISTORY_DAYS=90
